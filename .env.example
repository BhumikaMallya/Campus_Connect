# Copy to .env for local development and replace placeholders with your own values.
# Never commit .env or real credentials.
NODE_ENV=development
PORT=3000

# MySQL-compatible development database connection.
DATABASE_URL=mysql://USERNAME:PASSWORD@localhost:3306/campusconnect

# Manus project / OAuth configuration (obtain from your own authorized project setup).
MANUS_PROJECT_ID=replace-with-your-manus-project-id
MANUS_JWT_SECRET=replace-with-a-long-random-local-signing-secret
MANUS_OAUTH_API_URL=https://replace-with-your-manus-oauth-api
MANUS_OAUTH_PORTAL_URL=https://replace-with-your-manus-oauth-portal

# Manus platform API access used by server-side platform services.
MANUS_API_URL=https://replace-with-your-manus-api
MANUS_API_KEY=replace-with-your-manus-api-key

# Optional: browser-safe key and trusted administrator account identifier.
# Do not put a private API key in this browser-visible value.
MANUS_API_BROWSER_KEY=replace-with-your-public-browser-key
OWNER_OPEN_ID=replace-with-the-trusted-admin-open-id
